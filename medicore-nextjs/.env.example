# Copy to .env (../start.sh does this for you and fills in random secrets).

# --- MySQL container (docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=medicore
MYSQL_USER=medicore
MYSQL_PASSWORD=change-me
MYSQL_PORT=3307

# --- App ---
# Must match the MySQL values above.
DATABASE_URL="mysql://medicore:change-me@127.0.0.1:3307/medicore"
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
APP_PORT=3000

# --- Optional ---
# docker (default): ../start.sh manages a MySQL container. external: use DATABASE_URL as-is.
# DB_MODE=docker
# IANA time zone used for "today" on dashboards (default: server time zone).
# APP_TIMEZONE=Asia/Kolkata
# Admin password the seed uses when it creates the admin user (default 1234).
# SEED_ADMIN_PASSWORD=
